# Copy to .env in this folder, on the instance, and fill in. Never commit .env.

# The domain the game is served on, with no https:// and no slash. Its DNS A record must point at the instance.
# odysseydojo.us is the worked example: replace it with the domain that was registered.
DOMAIN=odysseydojo.us

# Optional. Leave empty: on the hosted copy no visitor can reach the routes that use them (see docs/deploy-vultr.md).
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
