# Copy to .env in this folder, on the instance, and fill in. Never commit .env.

# The domain the game is served on, with no https:// and no slash. Its DNS A record must point at the instance.
# odysseydojo.us is the worked example: replace it with the domain that was registered.
DOMAIN=odysseydojo.us

# Optional. Leave empty: on the hosted copy no visitor can reach the routes that use them (see docs/deploy-vultr.md).
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Optional, for when the page is hosted on Vercel and this instance is only the room server (docs/deploy-vercel.md).
# Then DOMAIN above is the api name, for example DOMAIN=api.odysseydojo.us.
# PUBLIC_ROOMS=1 lets visitors make rooms, not only join them. It does nothing until the server has the guard change
# that reads it (see "The guard change" in docs/deploy-vercel.md). Leave it out and the server behaves as before.
# PUBLIC_ROOMS=1
