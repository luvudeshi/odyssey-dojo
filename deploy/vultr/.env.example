# Copy to .env in this folder, on the instance, and fill in. Never commit .env.

# The domain the game is served on, with no https:// and no slash. Its DNS A record must point at the instance.
# odysseydojo.us is the worked example: replace it with the domain that was registered.
DOMAIN=odysseydojo.us

# Optional. Leave empty: on the hosted copy no visitor can reach the routes that use them (see docs/deploy-vultr.md).
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Lets visitors make rooms on the hosted copy. Only exactly 1 turns it on. See docs/rooms-tunnel.md, "The hosted copy".
PUBLIC_ROOMS=1

# Accounts and the hall of heroes (docs/deploy-vultr.md, "Accounts on the hosted copy"). The string is a secret:
# type it on the instance only. The CA file goes in ./certs on the instance.
PUBLIC_ACCOUNTS=1
DATABASE_URL=
DATABASE_CA_FILE=/app/certs/tiger-ca.pem
