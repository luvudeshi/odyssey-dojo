{
  "name": "odyssey-fighter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "sh scripts/vendor-pose.sh || echo 'pose model not vendored: run make setup with a network connection'",
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "build": "vite build",
    "server": "tsx server/main.ts",
    "dev:server": "tsx watch server/main.ts",
    "dev:all": "concurrently -k -n web,api \"vite\" \"tsx watch server/main.ts\"",
    "start": "vite build && tsx server/main.ts",
    "preflight": "tsx server/tools/preflight.ts",
    "tunnel": "node scripts/tunnel.mjs"
  },
  "dependencies": {
    "@google/genai": "3.3.0",
    "@mediapipe/tasks-vision": "1.2.3",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "postprocessing": "6.39.6",
    "express": "5.3.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
