# Copy to .env and fill in. The server reads it; the keys never reach the browser. Never commit .env.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Optional
# AI_SERVER_PORT=8787
# PUBLIC_BASE_URL=http://192.168.1.20:8787   (what a phone should open for replay links)
# The Tiger Data connection string, for accounts (docs/accounts.md). Left out, the game has no accounts.
# It must end in ?sslmode=require and nothing may follow it on its line.
# DATABASE_URL=
